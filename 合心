*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,"Microsoft JhengHei",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed}
#app{display:flex;height:100vh;overflow:hidden}#sidebar{width:250px;flex-shrink:0;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px;transition:transform .2s;z-index:20}.logo{font-size:21px;font-weight:800;color:var(--blue);padding:8px 5px 18px}#newChat{width:100%;padding:12px;border:1px solid #d9e2ec;background:#fff;border-radius:10px;text-align:left;margin-bottom:12px}.nav-title{font-size:12px;color:#9298a1;margin:14px 8px 6px}.nav-button{width:100%;padding:10px 12px;border:0;border-radius:9px;background:transparent;text-align:left;color:#333;margin:2px 0}.nav-button:hover,.nav-button.active{background:#eaf3ff;color:var(--blue)}#chatList{overflow:auto;flex:1;min-height:45px}.chat-item{display:flex;align-items:center;gap:4px;padding:7px;border-radius:8px}.chat-item.active,.chat-item:hover{background:#f0f4f8}.chat-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;cursor:pointer}.chat-action{border:0;background:transparent;padding:4px}#main{flex:1;min-width:0;display:flex;flex-direction:column}#topbar{height:62px;flex-shrink:0;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 20px;gap:14px}#menuButton{display:none;border:0;background:transparent;font-size:22px}.toplogo{font-size:19px;font-weight:bold;color:var(--blue)}#pageTitle{margin-left:auto;color:#606873;font-size:14px}#statusBar{font-size:12px;color:#687384;text-align:center;padding:7px;background:#fff;border-bottom:1px solid #f0f0f0}#retryLoad{display:none;margin:8px auto}
#workspace{flex:1;min-height:0;overflow:auto}.page{display:none;min-height:100%;}.page.active{display:block}.content{max-width:1050px;margin:auto;padding:30px 28px 48px}.content h1{margin:0 0 8px;font-size:27px}.lead{color:var(--muted);margin:0 0 22px}.card{background:var(--card);border:1px solid var(--line);border-radius:13px;padding:18px;margin:14px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.feature{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px;min-height:145px}.feature h3{margin:0 0 8px}.feature p{font-size:13px;line-height:1.6;color:var(--muted);min-height:40px}.small{font-size:12px;color:var(--muted)}.primary{background:var(--blue);color:#fff;border:0;border-radius:9px;padding:10px 15px}.secondary{background:#eef1f5;color:#263445;border:0;border-radius:9px;padding:10px 15px}.danger{background:#fff0f0;color:#a12a2a;border:1px solid #f0d0d0;border-radius:9px;padding:10px 15px}.actions{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:12px 0}.field{width:100%;padding:11px 12px;border:1px solid #ccd3dc;border-radius:9px;background:#fff;margin:7px 0 13px}.field:focus{outline:2px solid #c6e0ff;border-color:var(--blue)}textarea.field{min-height:105px;resize:vertical}.label{font-size:13px;font-weight:700;display:block;margin-top:8px}.status{font-size:13px;color:#657286;white-space:pre-wrap;margin:10px 0}.preview{background:#f7f8fa;border:1px dashed #cbd2dc;border-radius:10px;padding:14px;min-height:80px;overflow:auto}.preview img{max-width:100%;height:auto;border-radius:10px}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.welcome{text-align:center;margin:65px auto;color:#526176}.welcome h1{font-size:29px;color:#26384d}.message{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;padding:13px 15px;border-radius:14px;margin:12px 0}.message.user{background:#dcecff;margin-left:14%}.message.ai{background:#fff;border:1px solid var(--line);margin-right:14%}#chatMessages{max-width:920px;margin:auto;padding:18px;min-height:200px}#chatFooter{position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);padding:12px}#inputArea{max-width:920px;margin:auto;display:flex;gap:8px}#question{flex:1;min-width:0;padding:13px 16px;border:1px solid #cbd3dd;border-radius:24px}#inputHint{text-align:center;color:#999;font-size:11px;margin-top:7px}#codeFrame{width:100%;height:440px;border:1px solid #cbd3dd;border-radius:10px;background:#fff}#codeEditor{font-family:ui-monospace,monospace;font-size:12px;min-height:260px}#imagePreview img{max-width:100%;height:auto}#libraryItems .library-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px;border-bottom:1px solid var(--line)}
@media(max-width:760px){#sidebar{position:fixed;top:0;bottom:0;left:0;transform:translateX(-105%);box-shadow:4px 0 20px #0001}#sidebar.open{transform:translateX(0)}#menuButton{display:block}#topbar{padding:0 12px}.content{padding:22px 15px 38px}.two{grid-template-columns:1fr}.message.user{margin-left:5%}.message.ai{margin-right:3%}}
</style>
