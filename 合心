<body>
<div id="app">
<aside id="sidebar">
  <div class="logo">🤖 ChatTW AI 8.3</div>
  <button id="newChat">＋ 開啟新聊天</button>
  <div class="nav-title">工作空間</div>
  <button class="nav-button active" data-page="chatPage" data-title="AI 聊天">💬 AI 聊天</button>
