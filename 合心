<section id="imagePage" class="page"><div class="content"><h1>🎨 AI 圖片生成</h1><p class="lead">輸入描述，產生一張圖片。</p><div class="card"><label class="label">圖片描述</label><textarea id="imagePrompt" class="field" placeholder="例如：一座漂浮在雲海上的奇幻城堡，柔和的晨光..."></textarea><div class="two"><div><label class="label">圖片尺寸</label><select id="imageSize" class="field"><option value="512x512">正方形 512 × 512</option><option value="768x512">橫向 768 × 512</option><option value="512x768">直向 512 × 768</option></select></div><div><label class="label">圖片風格</label><select id="imageStyle" class="field"><option value="">自動</option><option value="realistic photography">寫實攝影</option><option value="watercolor illustration">水彩插畫</option><option value="anime illustration">動漫插畫</option><option value="oil painting">油畫</option><option value="3D render">3D 立體</option></select></div></div><div class="actions"><button id="generateImage" class="primary">生成圖片</button><button id="openImage" class="secondary" disabled>新分頁開啟</button><button id="saveImage" class="secondary" disabled>存入作品庫</button></div><div id="imageStatus" class="status">等待生成。</div><div id="imagePreview" class="preview"></div></div></div></section>
<section id="documentPage" class="page"><div class="content"><h1>📄 文件閱讀與摘要</h1><p class="lead">支援 PDF、DOCX、TXT，也可以直接貼上文字。</p><div class="card"><label class="label">選擇文件</label><input id="documentFile" class="field" type="file" accept=".pdf,.docx,.txt,.md"><div class="actions"><button id="readDocument" class="primary">讀取文件</button><button id="summarizeDocument" class="secondary" disabled>AI 摘要</button><button id="saveSummary" class="secondary" disabled>儲存摘要</button></div><div id="documentStatus" class="status"></div><label class="label">文件文字</label><textarea id="documentText" class="field" placeholder="讀取文件後，內容會顯示在這裡；也可以直接貼上文字。"></textarea></div><div class="card"><h3>AI 摘要結果</h3><div id="summaryText" class="preview">摘要會顯示在這裡。</div></div></div></section>
<section id="codePage" class="page"><div class="content"><h1>💻 程式工作室</h1><p class="lead">撰寫 HTML、CSS 和 JavaScript，並即時預覽。</p><div class="card"><label class="label">程式碼編輯器</label><textarea id="codeEditor" class="field" placeholder="在這裡輸入 HTML 程式碼..."></textarea><div class="actions"><button id="starterCode" class="secondary">載入範例</button><button id="runCode" class="primary">執行預覽</button><button id="downloadCode" class="secondary">下載 HTML</button><button id="saveCode" class="secondary">存入作品庫</button></div><div id="codeStatus" class="status"></div><iframe id="codeFrame" sandbox="allow-scripts allow-forms"></iframe></div></div></section>
<section id="libraryPage" class="page"><div class="content"><h1>📚 我的作品庫</h1><p class="lead">管理已儲存的作品。</p><div class="card"><div class="actions"><button id="refreshLibrary" class="secondary">重新整理</button><button id="clearLibrary" class="danger">清空作品庫</button></div><div id="libraryItems"></div></div></div></section>
<section id="settingsPage" class="page"><div class="content"><h1>⚙️ 設定</h1><p class="lead">管理 ChatTW AI 的基本設定。</p><div class="card"><h3>AI 模型</h3><p class="small">使用瀏覽器中的 AI 模型。首次載入需要下載模型資料，請保持網路連線。</p><button id="retryLoad2" class="secondary">重新載入 AI</button></div><div class="card"><h3>聊天與記憶</h3><div class="actions"><button id="clearMemory" class="danger">清除個人記憶</button><button id="clearChats" class="danger">清除聊天紀錄</button></div></div><div class="card"><p class="small">ChatTW AI 8.3</p></div></div></section>
</div></main></div>
<script type="module">
import { pipeline, env } from "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.7.2";
env.allowLocalModels=false;
env.useBrowserCache=true;
let generator=null,loadingPromise=null,isGenerating=false;
let chats=[],activeChatId=null,memory={},lastSummary="",currentImageUrl="",imageGenerating=false,currentChart=null,gameHTML="";
const $=id=>document.getElementById(id);
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function makeId(){return Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function readStore(key,fallback){try{const x=localStorage.getItem(key);return x?JSON.parse(x):fallback}catch{return fallback}}
function writeStore(key,value){try{localStorage.setItem(key,JSON.stringify(value))}catch(e){console.warn("儲存失敗",e)}}
function formatAnswer(text){return String(text||"").replace(/\r\n/g,"\n").trim()}
function aiValueToText(value){if(value==null)return "";if(typeof value==="string")return value;if(typeof value==="number"||typeof value==="boolean")return String(value);if(Array.isArray(value))return value.map(aiValueToText).filter(Boolean).join("\n");if(typeof value==="object"){for(const k of ["text","content","answer","output","generated_text","value"])if(value[k]!=null)return aiValueToText(value[k]);return JSON.stringify(value)}return String(value)}
async function loadAI(){if(generator)return generator;if(loadingPromise)return loadingPromise;$("statusBar").textContent="正在載入 AI 模型，首次載入可能需要一些時間...";$("retryLoad").style.display="none";loadingPromise=(async()=>{try{generator=await pipeline("text-generation","onnx-community/Qwen2.5-0.5B-Instruct",{dtype:"q4",device:"wasm",progress_callback:p=>{if(p.status==="progress")$("statusBar").textContent=`AI 模型載入中：${p.file||""} ${Math.round(p.progress||0)}%`;else if(p.status==="downloading")$("statusBar").textContent="正在下載 AI 模型："+(p.file||"")}});$("statusBar").textContent="✅ AI 已載入，可以開始聊天！";return generator}catch(e){console.error(e);$("statusBar").textContent="❌ AI 載入失敗："+e.message;$("retryLoad").style.display="block";generator=null;throw e}finally{loadingPromise=null}})();return loadingPromise}
async function askAI(prompt,maxTokens=600){await loadAI();const r=await generator([{role:"system",content:"你是 ChatTW，一個可靠、友善的繁體中文 AI 助手。請使用臺灣繁體中文回答，清楚、正確，不要捏造資料。"},{"role":"user",content:prompt}],{max_new_tokens:maxTokens,do_sample:false});const g=r?.[0]?.generated_text;const out=Array.isArray(g)?g[g.length-1]?.content:g;return formatAnswer(aiValueToText(out))}
function getCurrentChat(){return chats.find(c=>c.id===activeChatId)}
function saveChats(){writeStore("chattw_chats",chats)}
function renderChatList(){const root=$("chatList");root.innerHTML="";chats.slice().reverse().forEach(chat=>{const row=document.createElement("div");row.className="chat-item"+(chat.id===activeChatId?" active":"");const name=document.createElement("div");name.className="chat-name";name.textContent=chat.title||"新聊天";name.onclick=()=>{activeChatId=chat.id;renderChatList();renderMessages()};const del=document.createElement("button");del.className="chat-action";del.textContent="×";del.title="刪除聊天";del.onclick=()=>{chats=chats.filter(c=>c.id!==chat.id);if(activeChatId===chat.id){activeChatId=chats[0]?.id||null}if(!chats.length)newChat();saveChats();renderChatList();renderMessages()};row.append(name,del);root.append(row)})}
function renderMessages(){const root=$("chatMessages");root.innerHTML="";const chat=getCurrentChat();if(!chat||!chat.messages.length){root.innerHTML='<div class="welcome"><h1>你好！我是 ChatTW AI</h1><p>今天想一起完成什麼呢？</p></div>';return}chat.messages.forEach(m=>{const div=document.createElement("div");div.className="message "+(m.role==="user"?"user":"ai");div.textContent=m.content;root.append(div)});root.scrollTop=root.scrollHeight}
function newChat(){const c={id:makeId(),title:"新聊天",messages:[],createdAt:Date.now()};chats.push(c);activeChatId=c.id;saveChats();renderChatList();renderMessages()}
async function sendMessage(){const input=$("question");const text=input.value.trim();if(!text||isGenerating)return;let chat=getCurrentChat();if(!chat){newChat();chat=getCurrentChat()}input.value="";chat.messages.push({role:"user",content:text});if(chat.messages.length===1)chat.title=text.slice(0,24);renderMessages();renderChatList();isGenerating=true;$("send").disabled=true;const placeholder=document.createElement("div");placeholder.className="message ai";placeholder.textContent="正在思考...";$("chatMessages").append(placeholder);try{const history=chat.messages.slice(-10).map(m=>({role:m.role,content:m.content}));const prompt=history.map(m=>(m.role==="user"?"使用者":"ChatTW")+ "："+m.content).join("\n")+"\nChatTW：";const answer=await askAI(prompt,700);placeholder.textContent=answer||"抱歉，我暫時無法回答。";chat.messages.push({role:"assistant",content:placeholder.textContent});saveChats()}catch(e){placeholder.textContent="AI 發生問題："+e.message}finally{isGenerating=false;$("send").disabled=false;renderChatList();$("chatMessages").scrollTop=$("chatMessages").scrollHeight}}
function switchPage(id,title){document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));$(id).classList.add("active");$("pageTitle").textContent=title;document.querySelectorAll(".nav-button[data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===id||(id!=="chatPage"&&id!=="settingsPage"&&b.dataset.page==="createPage")));$("sidebar").classList.remove("open")}
document.querySelectorAll(".nav-button[data-page]").forEach(b=>b.onclick=()=>switchPage(b.dataset.page,b.dataset.title));
document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>{const id=b.dataset.go;switchPage(id,({imagePage:"AI 圖片生成",documentPage:"文件閱讀與摘要",codePage:"程式工作室",libraryPage:"我的作品庫"})[id]||"AI 創作中心")});
$("newChat").onclick=newChat;$("menuButton").onclick=()=>$("sidebar").classList.toggle("open");
$("send").onclick=sendMessage;$("question").addEventListener("keydown",e=>{if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();sendMessage()}});
function downloadBlob(blob,name){const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1500)}
function addLibrary(type,title,detail){const items=readStore("chattw_library",[]);items.unshift({id:makeId(),type,title,detail,createdAt:new Date().toLocaleString("zh-TW")});writeStore("chattw_library",items.slice(0,100));renderLibrary()}
function renderLibrary(){const items=readStore("chattw_library",[]);const root=$("libraryItems");root.innerHTML="";if(!items.length){root.innerHTML='<p class="small">目前沒有作品。完成圖片、文件摘要或程式作品後，可以存入作品庫。</p>';return}items.forEach(item=>{const row=document.createElement("div");row.className="library-row";const left=document.createElement("div");const title=document.createElement("strong");title.textContent=item.title;const meta=document.createElement("div");meta.className="small";meta.textContent=item.type+" · "+item.createdAt;left.append(title,meta);const del=document.createElement("button");del.className="danger";del.textContent="刪除";del.onclick=()=>{writeStore("chattw_library",readStore("chattw_library",[]).filter(x=>x.id!==item.id));renderLibrary()};row.append(left,del);root.append(row)})}
$("refreshLibrary").onclick=renderLibrary;$("clearLibrary").onclick=()=>{if(confirm("確定清空作品庫嗎？")){writeStore("chattw_library",[]);renderLibrary()}};
async function generateImage(){const prompt=$("imagePrompt").value.trim();if(!prompt){$("imageStatus").textContent="請先輸入圖片描述。";return}if(imageGenerating)return;imageGenerating=true;const btn=$("generateImage");btn.disabled=true;$("openImage").disabled=true;$("saveImage").disabled=true;currentImageUrl="";$("imageStatus").textContent="正在送出圖片需求...";$("imagePreview").innerHTML='<span class="small">正在連接 AI Horde，請稍候...</span>';try{const base="https://aihorde.net/api/v2";const headers={"Content-Type":"application/json","apikey":"0000000000","Client-Agent":"ChatTW:8.3:public-web-app"};const [width,height]=$("imageSize").value.split("x").map(Number);const style=$("imageStyle").value;const fullPrompt=prompt+(style?", "+style+" style":"");const resp=await fetch(base+"/generate/async",{method:"POST",headers,body:JSON.stringify({prompt:fullPrompt,params:{n:1,width,height,steps:20,sampler_name:"k_euler"},nsfw:false,censor_nsfw:true,models:["stable_diffusion"]})});if(!resp.ok)throw new Error("服務回應 "+resp.status+"："+(await resp.text()).slice(0,160));const job=await resp.json();if(!job.id)throw new Error(job.message||"沒有取得任務編號");let done=false;for(let i=0;i<120;i++){await sleep(5000);const check=await fetch(base+"/generate/check/"+job.id,{headers});if(!check.ok)throw new Error("查詢進度失敗："+check.status);const s=await check.json();$("imageStatus").textContent=`排隊／生成中... 已等待 ${(i+1)*5} 秒；等待工作 ${s.waiting??"?"}`;if(s.done){done=true;break}}if(!done)throw new Error("等待時間較長，任務可能仍在排隊，請稍後再試。");$("imageStatus").textContent="正在取得圖片...";const result=await fetch(base+"/generate/status/"+job.id,{headers});if(!result.ok)throw new Error("取得圖片失敗："+result.status);const data=await result.json();const url=data.generations?.[0]?.img;if(!url)throw new Error("目前沒有可用的圖片結果。");currentImageUrl=url;const img=document.createElement("img");img.src=url;img.alt="ChatTW AI 生成圖片";img.onload=()=>$("imageStatus").textContent="✅ 圖片生成完成！";img.onerror=()=>$("imageStatus").textContent="圖片已完成，但預覽載入失敗；可嘗試在新分頁開啟。";$("imagePreview").innerHTML="";$("imagePreview").append(img);$("openImage").disabled=false;$("saveImage").disabled=false}catch(e){console.error(e);$("imageStatus").textContent="❌ 生成未完成："+e.message;$("imagePreview").textContent="圖片尚未生成，請稍後重試。"}finally{imageGenerating=false;btn.disabled=false}}
$("generateImage").onclick=generateImage;$("openImage").onclick=()=>{if(currentImageUrl)window.open(currentImageUrl,"_blank","noopener")};$("saveImage").onclick=()=>{if(currentImageUrl){addLibrary("圖片",$("imagePrompt").value.trim()||"AI 圖片",currentImageUrl);$("imageStatus").textContent="圖片資訊已存入作品庫。"}};
async function extractDocument(file){const name=file.name.toLowerCase();if(name.endsWith(".pdf")){if(!window.pdfjsLib)throw new Error("PDF 讀取元件未載入");pdfjsLib.GlobalWorkerOptions.workerSrc="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;let out="";for(let i=1;i<=pdf.numPages;i++){const page=await pdf.getPage(i);const content=await page.getTextContent();out+=`\n[第 ${i} 頁]\n`+content.items.map(x=>x.str).join(" ")+"\n"}return out}if(name.endsWith(".docx")){if(!window.mammoth)throw new Error("DOCX 讀取元件未載入");const result=await mammoth.extractRawText({arrayBuffer:await file.arrayBuffer()});return result.value}return await file.text()}
