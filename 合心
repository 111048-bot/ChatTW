$("summarizeDocument").onclick=async()=>{const text=$("documentText").value.trim();if(!text){$("documentStatus").textContent="請先讀取或貼上文件文字。";return}$("summarizeDocument").disabled=true;$("documentStatus").textContent="AI 正在整理文件...";try{lastSummary=await askAI("請用臺灣繁體中文摘要以下文件。請列出：一、主旨；二、重要重點；三、關鍵名詞；四、結論。不可補造原文沒有的資料。\n\n文件內容：\n"+text.slice(0,12000),850);$("summaryText").textContent=lastSummary;$("saveSummary").disabled=false;$("documentStatus").textContent="摘要完成。"}catch(e){$("documentStatus").textContent="摘要失敗："+e.message}finally{$("summarizeDocument").disabled=false}};
